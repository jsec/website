---
import { SITE, NAV, BUILD } from "../consts";
interface Props { path: string }
const { path } = Astro.props;
const active = (p: string) => (p === "/" ? path === "/" : path.startsWith(p));
---
<aside class="rail">
  <div class="stack" style="gap:8px">
    <a href="/" class="accent">{SITE.name}</a>
    <span class="dim" style="font-size:13px">{SITE.title}</span>
  </div>

  <nav>
    {NAV.map((item) => (
      <a href={item.path} class:list={["nav-item", { on: active(item.path) }]}>
        <span aria-hidden="true">{active(item.path) ? ">" : "\u00a0"}</span> {item.label}
      </a>
    ))}
  </nav>

  <slot />

  <div class="build">
    <div>build {BUILD.hash}</div>
  </div>
</aside>

<style>
  .rail {
    border-right: 1px solid var(--rule);
    background: var(--bg-panel);
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  nav { 
      display: flex; 
      flex-direction: column; 
      border-top: 1px solid var(--rule); 
  }

  .nav-item {
    padding: 6px 0;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--fg-body);
    white-space: pre;
  }

  .nav-item.on { 
      color: var(--accent); 
  }
  .nav-item.on:hover { 
      color: var(--bg); 
  }

  .build { 
      margin-top: auto; 
      font-size: 12px; 
      line-height: 20px; 
      color: var(--fg-ghost); 
  }

  @media (max-width: 720px) {
    .rail {
      border-right: none;
      border-bottom: 1px solid var(--rule);
      padding: 16px 20px;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 2;
    }

    nav { 
        flex-direction: row; 
        gap: 16px; 
        border-top: none; 
        overflow-x: auto; 
    }

    .nav-item { 
        border-bottom: none; font-size: 14px; 
    }

    .nav-item.on { 
        border-bottom: 1px solid var(--accent); 
    }

    .nav-item span { 
        display: none; 
    }

    .rail :global(.rail-extra) { 
        display: none; 
    }

    .build { 
        display: none; 
    }
  }
</style>
