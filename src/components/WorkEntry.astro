---
import { render, type CollectionEntry } from "astro:content";
import { ym, hash } from "../lib/format";
interface Props { entry: CollectionEntry<"work">; open?: boolean; head?: boolean }
const { entry, open = false, head = false } = Astro.props;
const { company, role, dateStart, dateEnd, stack } = entry.data;
const { Content } = await render(entry);
const range = `${ym(dateStart)} → ${ym(dateEnd)}`;
---
<div class="commit">
  <div class="graph" aria-hidden="true"><span class="line"></span><span class="star">*</span></div>
  <details id={entry.id} open={open}>
    <summary class="commit-row">
      <span class="acc">{hash(entry.id)}</span>
      <span>
        {company} <span class="dim">— {role}</span>{head && <span class="head"> (HEAD)</span>}
        <span class="range-narrow">{range}</span>
      </span>
      <span class="range">{range}</span>
    </summary>
    <div class="body sans">
      <Content />
      <span class="stack dim">{stack.join(" · ")}</span>
    </div>
  </details>
</div>

<style>
  .commit { display: grid; grid-template-columns: 3ch minmax(0, 1fr); }
  .graph { position: relative; display: flex; justify-content: center; }
  .line { position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background: var(--rule); }
  .star { position: relative; color: var(--acc); background: var(--bg); height: 24px; margin-top: 8px; }

  summary { padding: 8px 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--acc); }
  .head { color: var(--acc); font-size: 12px; }

  .body {
    padding: 4px 0 24px calc(8ch + 16px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 24px;
    color: var(--body);
  }
  .body :global(p) { max-width: 66ch; }
  /* The markdown's "Highlights" subheading is not part of the design. */
  .body :global(h4) { display: none; }
  .body :global(ul) { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .body :global(li) { display: grid; grid-template-columns: 2ch minmax(0, 1fr); max-width: 68ch; text-wrap: pretty; }
  .body :global(li)::before { content: "–"; color: var(--faint); }
  .stack { font-family: var(--mono); font-size: 13px; }

  @media (max-width: 759px) { .body { padding-left: 0; } }
</style>
