---
import type { CollectionEntry } from "astro:content";
import { ymd, readingTime } from "../lib/format";
interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { date, title, summary } = post.data;
const read = readingTime(post.body ?? "");
---
<a href={`/blog/${post.id}`} class="row">
  <time class="dim wide" datetime={ymd(date)}>{ymd(date)}</time>
  <span class="dim wide">{read}</span>
  <span class="body">
    <span class="dim meta">{ymd(date)} · {read}</span>
    <span>{title}</span>
    <span class="summary sans dim">{summary}</span>
  </span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 12ch 7ch minmax(0, 1fr);
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .body { display: flex; flex-direction: column; min-width: 0; }
  .summary { font-size: 15px; }
  .meta { display: none; font-size: 13px; }

  @media (max-width: 759px) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .wide { display: none; }
    .meta { display: block; }
  }
</style>
