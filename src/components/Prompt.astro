---
interface Props { cwd: string; cmd?: string }
const { cwd, cmd } = Astro.props;
---
<div class="prompt">
  <span class="dim">{cwd}</span>
  <span class="acc">$</span>
  {cmd ? <span>{cmd}</span> : <slot />}
</div>

<style>
  .prompt { display: flex; gap: 1ch; flex-wrap: wrap; align-items: center; }
</style>
