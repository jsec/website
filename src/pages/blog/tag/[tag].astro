---
import { getCollection } from "astro:content";
import Shell from "../../../layouts/Shell.astro";
import Prompt from "../../../components/Prompt.astro";
import PostRow from "../../../components/PostRow.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => +b.data.date - +a.data.date),
    },
  }));
}

const { tag, posts } = Astro.props;
---
<Shell title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <section class="block">
    <Prompt cwd="~/blog" cmd={`grep -l ${tag} *.md`} />
    <span class="dim">{posts.length} {posts.length === 1 ? "match" : "matches"}</span>
  </section>

  <div class="rows">
    {posts.map((p) => <PostRow post={p} />)}
  </div>
</Shell>

<style>
  .block { display: flex; flex-direction: column; gap: 12px; }
  .rows { display: flex; flex-direction: column; margin-top: -16px; }
</style>
