---
import { getCollection } from "astro:content";
import Shell from "../../layouts/Shell.astro";
import Prompt from "../../components/Prompt.astro";
import PostRow from "../../components/PostRow.astro";

const posts = (await getCollection("blog", (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Shell title="Blog">
  <section class="block">
    <Prompt cwd="~/blog" cmd="ls -l" />
    <span class="dim">total {posts.length}</span>
  </section>

  <div class="rows">
    {posts.map((p) => <PostRow post={p} />)}
  </div>
</Shell>

<style>
  .block { display: flex; flex-direction: column; gap: 12px; }
  .rows { display: flex; flex-direction: column; margin-top: -16px; }
</style>
