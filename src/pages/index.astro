---
import { getCollection } from "astro:content";
import Shell from "../layouts/Shell.astro";
import Prompt from "../components/Prompt.astro";
import { SITE, NOW } from "../consts";
import { ym } from "../lib/format";

const projects = (await getCollection("projects", (p) => p.data.featured && !p.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);
const work = await getCollection("work");
---
<Shell crumb="~/home">
  <div slot="rail" class="rail-extra links">
    <span class="label">elsewhere</span>
    <a href={`mailto:${SITE.email}`}>email</a>
    <a href={SITE.github} target="_blank" rel="noopener noreferrer">github</a>
    <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
    <a href="/rss.xml">rss</a>
  </div>

  <section class="intro">
    <h1>I write backends that other engineers don't have to babysit.</h1>
    <p>
        I've spent the last 15 years building software in a weird mix of industries: payroll, manufacturing, mortgages, public safety, healthcare, parking, and now healthcare again.
    </p>
    <p>
        My day job involves Node and TypeScript, but I find myself playing more with Python and Go these days. 
        I care a lot about observability, keeping interfaces small, and choosing boring infrastructure when it'll do the job. If it takes an hour to figure out what a piece of code does, I'm going to want to rewrite it.
    </p>
  </section>

  <div class="facts">
    <div class="fact">
      <span class="label">now</span>
      <span>{NOW.role}</span>
      <span class="dim">{NOW.company} · since {NOW.since}</span>
    </div>
    <div class="fact">
      <span class="label">shipping since</span>
      <span>2011</span>
      <span class="dim">across 7 industries</span>
    </div>
  </div>

  <section class="block">
    <div class="head">
      <span>selected projects</span>
      <a href="/projects">all →</a>
    </div>
    {projects.map((p) => (
      <a href={`/projects/${p.id}`} class="card">
        <div class="card-head"><span>{p.data.title}</span><span class="dim">{ym(p.data.date)}</span></div>
        <span class="dim">{p.data.summary}</span>
        <div class="tags">{Object.values(p.data.facts).map((v) => <span class="tag">{v}</span>)}</div>
      </a>
    ))}
  </section>

  <section class="block prompt-block">
    <Prompt />
  </section>
</Shell>

<style>
  .links { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--fg-body); }
  .label { color: var(--fg-faint); letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; line-height: 20px; }

  .intro { display: flex; flex-direction: column; gap: 16px; }
  .intro p { max-width: 74ch; color: var(--fg-body); }

  .facts { display: flex; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .fact { flex: 1; background: var(--bg); padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; }

  .block { display: flex; flex-direction: column; gap: 16px; }
  .head {
    display: flex; justify-content: space-between; align-items: baseline;
    border-bottom: 1px solid var(--rule); padding-bottom: 8px;
    font-size: 13px; color: var(--fg-dim); letter-spacing: 0.08em; text-transform: uppercase;
  }
  .head a { text-transform: none; letter-spacing: 0; }

  .card { display: flex; flex-direction: column; gap: 6px; padding: 16px; border: 1px solid var(--rule); background: var(--bg-panel); }
  .card:hover { border-color: var(--accent); background: var(--bg-panel); color: var(--fg); }
  .card-head { display: flex; justify-content: space-between; gap: 16px; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; }

  .prompt-block { border-top: 1px solid var(--rule); padding-top: 24px; }

  @media (max-width: 720px) {
    h1 { font-size: 21px; line-height: 32px; }
    .facts { flex-direction: column; }
  }
</style>
