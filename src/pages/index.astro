---
import { getCollection } from "astro:content";
import Shell from "../layouts/Shell.astro";
import Prompt from "../components/Prompt.astro";
import { ym, ymd, hash } from "../lib/format";

const work = (await getCollection("work")).sort((a, b) => +b.data.dateStart - +a.data.dateStart);
const now = work.find((w) => w.data.dateEnd === "Now");
const posts = (await getCollection("blog", (p) => !p.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
---
<Shell>
  <section class="block">
    <Prompt cwd="~" cmd="whoami" />
    <div class="whoami sans">
      <h1>I've written enough microservices to know you don't need one.</h1>
      <p>Fifteen years across payroll, manufacturing, mortgages, public safety, healthcare and parking.</p>
    </div>
  </section>

  {now && (
    <section class="block">
      <Prompt cwd="~" cmd="cat now" />
      <div class="now">
        <span class="dim">role</span><span>{now.data.role} @ {now.data.company}</span>
        <span class="dim">since</span><span>{ym(now.data.dateStart)}</span>
        <span class="dim">stack</span><span>{now.data.stack.join(", ")}</span>
      </div>
    </section>
  )}

  <section class="block">
    <Prompt cwd="~" cmd="git log --oneline -3 work" />
    <div class="rows">
      {work.slice(0, 3).map((w) => {
        const range = `${ym(w.data.dateStart)} → ${ym(w.data.dateEnd)}`;
        return (
          <a href={`/work#${w.id}`} class="commit-row">
            <span class="acc">{hash(w.id)}</span>
            <span>
              {w.data.company} <span class="dim">— {w.data.role}</span>
              <span class="range-narrow">{range}</span>
            </span>
            <span class="range">{range}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="block">
    <Prompt cwd="~" cmd="ls -t blog | head -3" />
    <div class="rows">
      {posts.map((p) => (
        <a href={`/blog/${p.id}`} class="post">
          <span class="dim">{ymd(p.data.date)}</span>
          <span>{p.data.title}</span>
        </a>
      ))}
    </div>
  </section>

  <Prompt cwd="~"><span class="cursor" aria-hidden="true"></span></Prompt>
</Shell>

<style>
  .block { display: flex; flex-direction: column; gap: 12px; }
  .whoami { display: flex; flex-direction: column; gap: 12px; }
  h1 { font-size: 26px; line-height: 36px; text-wrap: balance; }
  .whoami p { font-size: 16px; line-height: 26px; color: var(--body); }
  .now { display: grid; grid-template-columns: 10ch minmax(0, 1fr); color: var(--body); }
  .rows { display: flex; flex-direction: column; }
  .post { display: grid; grid-template-columns: 12ch minmax(0, 1fr); gap: 16px; }
  .cursor { width: 1ch; height: 18px; background: var(--fg); }

  @media (max-width: 759px) {
    .rows .range-narrow { margin-bottom: 8px; }
  }
</style>
