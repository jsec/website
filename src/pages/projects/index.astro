---
import { getCollection } from "astro:content";
import Shell from "../../layouts/Shell.astro";
import Prompt from "../../components/Prompt.astro";
import { ym } from "../../lib/format";

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Shell title="Projects">
  <div class="page">
    <section class="block">
      <Prompt cwd="~/projects" cmd="ls" />
      <div class="ls">{projects.map((p) => <a href={`#${p.id}`} class="acc">{p.data.title}/</a>)}</div>
    </section>

    <section class="block">
      <Prompt cwd="~/projects" cmd="cat */README" />
      {projects.map((p) => (
        <article id={p.id} class="card">
          <div class="head">
            <span class="name">{p.data.title}</span>
            <span class="dim">{ym(p.data.date)} · {p.data.status}</span>
          </div>
          <p class="sans desc">{p.data.summary}</p>
          <div class="stack dim">
            {Object.entries(p.data.facts).map(([k, v]) => <span>{k}={v}</span>)}
            <span class="links">
              {p.data.demo && <a href={p.data.demo} class="acc">live →</a>}
              {p.data.repo && <a href={p.data.repo} class="acc">source →</a>}
            </span>
          </div>
        </article>
      ))}
    </section>
  </div>
</Shell>

<style>
  .page { display: flex; flex-direction: column; gap: 32px; }
  .block { display: flex; flex-direction: column; gap: 12px; }
  .ls { display: flex; gap: 4ch; flex-wrap: wrap; }
  .card { display: flex; flex-direction: column; gap: 12px; padding: 20px 0; border-bottom: 1px solid var(--rule); }
  .head { display: flex; justify-content: space-between; gap: 16px; }
  .name { font-weight: 500; }
  .desc { font-size: 16px; line-height: 26px; color: var(--body); }
  .stack { display: flex; gap: 3ch; flex-wrap: wrap; font-size: 13px; }
  .links { margin-left: auto; display: flex; gap: 3ch; }
</style>
