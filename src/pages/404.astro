---
import Shell from "../layouts/Shell.astro";
import Prompt from "../components/Prompt.astro";
---
<Shell title="404">
  <section class="block">
    <Prompt cwd="~"><span>cat <span data-path>{"{path}"}</span></span></Prompt>
    <span class="dim">cat: <span data-path>{"{path}"}</span>: No such file or directory</span>
    <p class="sans lead">Either I moved it or you typed it. Both are recoverable.</p>
  </section>

  <section class="block">
    <Prompt cwd="~"><a href="/">cd ~</a></Prompt>
    <Prompt cwd="~"><a href="/blog">ls blog</a></Prompt>
    <Prompt cwd="~"><button data-palette-open>grep -ri</button></Prompt>
  </section>

  <script is:inline>
    for (const el of document.querySelectorAll("[data-path]")) el.textContent = location.pathname;
  </script>
</Shell>

<style>
  .block { display: flex; flex-direction: column; gap: 12px; }
  .lead { font-size: 16px; line-height: 26px; color: var(--body); }
</style>
