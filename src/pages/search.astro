---
import { getCollection } from "astro:content";
import Shell from "../layouts/Shell.astro";
import { ymd } from "../lib/format";

const posts = await getCollection("blog", (p) => !p.data.draft);
const projects = await getCollection("projects", (p) => !p.data.draft);

const docs = [
  ...posts.map((p) => ({ kind: "post", title: p.data.title, summary: p.data.summary, url: `/blog/${p.id}`, date: ymd(p.data.date) })),
  ...projects.map((p) => ({ kind: "project", title: p.data.title, summary: p.data.summary, url: `/projects/${p.id}`, date: ymd(p.data.date) })),
].sort((a, b) => b.date.localeCompare(a.date));
---
<Shell title="Search" crumb="~/search">
  <div slot="rail" class="rail-extra keys">
    <span class="label">keys</span>
    <div class="grid">
      <span>/</span><span class="dim">focus</span>
      <span>esc</span><span class="dim">clear</span>
      <span>↵</span><span class="dim">open first</span>
    </div>
  </div>

  <form class="field" role="search" onsubmit="return false">
    <span class="accent" aria-hidden="true">/</span>
    <input type="search" data-search autocomplete="off" spellcheck="false" placeholder="search posts and projects" aria-label="Search" />
  </form>

  <div class="status">
    <span data-search-count>{docs.length} results</span>
    <span class="dim">posts + projects</span>
  </div>

  <div class="results" data-search-results>
    <noscript>
      {docs.map((d) => (
        <a class="hit" href={d.url}>
          <span class="kind">{d.kind}</span>
          <time class="dim">{d.date}</time>
          <span class="body"><span>{d.title}</span><span class="summary dim">{d.summary}</span></span>
        </a>
      ))}
    </noscript>
  </div>

  <script id="search-data" type="application/json" set:html={JSON.stringify(docs)} is:inline />
  <script src="../scripts/search.ts"></script>
</Shell>

<style>
  .keys { display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .label { color: var(--fg-faint); letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; line-height: 20px; }
  .grid { display: grid; grid-template-columns: 6ch 1fr; gap: 0 8px; }

  .field { display: flex; align-items: center; gap: 12px; background: var(--bg-code); border: 1px solid var(--rule); padding: 11px 16px; }
  .field:focus-within { border-color: var(--accent); }
  .field input { flex: 1; min-width: 0; }

  .status { display: flex; justify-content: space-between; font-size: 13px; color: var(--fg-dim); border-bottom: 1px solid var(--rule); padding-bottom: 8px; }

  .results { display: flex; flex-direction: column; }
  .results :global(.hit) {
    display: grid; grid-template-columns: 10ch 12ch minmax(0, 1fr); gap: 16px;
    padding: 12px 8px; border-bottom: 1px solid var(--rule-soft);
  }
  .results :global(.hit:hover) { background: var(--bg-hover); color: var(--fg); }
  .results :global(.kind) { color: var(--accent); }
  .results :global(.body) { display: flex; flex-direction: column; min-width: 0; }
  .results :global(.summary) { font-size: 14px; }

  @media (max-width: 720px) {
    .results :global(.hit) { grid-template-columns: 10ch 1fr; gap: 4px 16px; }
  }
</style>
