---
import type { CollectionEntry } from "astro:content";
import Shell from "./Shell.astro";
import Prompt from "../components/Prompt.astro";
import { ymd, readingTime } from "../lib/format";

interface Props { entry: CollectionEntry<"blog"> }
const { entry } = Astro.props;
const { title, summary, date, tags } = entry.data;
---
<Shell title={title} description={summary}>
  <div class="post">
    <Prompt cwd="~/blog" cmd={`cat ${entry.id}.md`} />

    <header>
      <h1 class="sans">{title}</h1>
      <span class="dim meta">
        <time datetime={ymd(date)}>{ymd(date)}</time> · {readingTime(entry.body ?? "")}
        {tags.length > 0 && <> · {tags.map((t, i) => <>{i > 0 && ", "}<a href={`/blog/tag/${t}`}>{t}</a></>)}</>}
      </span>
    </header>

    <article class="sans">
      <slot />
    </article>

    <Prompt cwd="~/blog"><a href="/blog" class="dim">cd ..</a></Prompt>
  </div>
</Shell>

<style>
  .post { display: flex; flex-direction: column; gap: 28px; }
  header { display: flex; flex-direction: column; gap: 6px; padding-bottom: 20px; border-bottom: 1px solid var(--rule); }
  h1 { font-size: 30px; line-height: 40px; font-weight: 500; }
  .meta { font-size: 13px; }

  article {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 17px;
    line-height: 29px;
    color: var(--body);
  }
  article :global(h2) { font-family: var(--mono); font-size: 15px; color: var(--fg); margin-top: 8px; }
  article :global(h2)::before { content: "## "; color: var(--faint); }
  article :global(strong), article :global(code) { color: var(--fg); }
  article :global(code) { font-family: var(--mono); font-size: 0.9em; }
  article :global(a) { color: var(--acc); }
  article :global(ul), article :global(ol) { margin: 0; padding-left: 3ch; }
  article :global(blockquote) { margin: 0; padding-left: 3ch; border-left: 1px solid var(--rule); color: var(--dim); }
  article :global(pre) {
    margin: 0;
    padding: 16px 20px;
    background: var(--bg2) !important;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 22px;
    color: var(--fg);
    overflow-x: auto;
  }
  article :global(pre code) { font-size: inherit; }
</style>
